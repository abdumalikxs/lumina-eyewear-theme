<footer class="site-footer">
  <div class="footer-cols">
    {% for block in section.blocks %}
      <div class="footer-col">
        <h4>{{ block.settings.heading }}</h4>
        <p>{{ block.settings.body }}</p>
      </div>
  </div>

  <p class="copy">&copy; {{ 'now' | date: '%Y' }} Lumina Eyewear</p>
</footer>
